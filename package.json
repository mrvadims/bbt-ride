{
  "name": "bbt-ride",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "dev:seed": "node scripts/dev-seed.ts",
    "smoke": "node scripts/smoke.ts",
    "auth:schema": "node scripts/auth-schema.ts",
    "icons": "node scripts/icons.ts",
    "ui-smoke": "node scripts/ui-smoke.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@capacitor/core": "8.5.2",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.104.2",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
