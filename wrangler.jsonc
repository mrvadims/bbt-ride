{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bbt-ride",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only ride.bbt.team (attached by hand in the dashboard); no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bbt-ride",
      // Replace with the id printed by `npx wrangler d1 create bbt-ride` (SETUP.md §5).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      // Replace with the id printed by `npx wrangler kv namespace create CACHE` (SETUP.md §5).
      "id": "00000000000000000000000000000000"
    }
  ],
  "triggers": { "crons": ["15 */3 * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "https://ride.bbt.team",
    "GOOGLE_CLIENT_ID": "788843663115-civobe823j0r2vnkpgsjg7o8vqvik76c.apps.googleusercontent.com",
    "BOOTSTRAP_ADMIN_EMAIL": "mrvadims@gmail.com",
    "VAPID_SUBJECT": "mailto:info@bbt.team",
    "VAPID_PUBLIC_KEY": ""
  },
  "observability": { "enabled": true }
}
